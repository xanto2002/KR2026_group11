@prefix : <http://example.org/kr-group11/drinks#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/kr-group11/drinks#> .

<http://example.org/kr-group11/drinks> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/kr-group11/drinks#dislikesFlavour
:dislikesFlavour rdf:type owl:ObjectProperty ;
                 rdfs:domain :Person ;
                 rdfs:range :Flavour .


###  http://example.org/kr-group11/drinks#hasFlavour
:hasFlavour rdf:type owl:ObjectProperty ;
            rdfs:range :Flavour ;
            owl:propertyChainAxiom ( :hasIngredient
                                     :hasFlavour
                                   ) .


###  http://example.org/kr-group11/drinks#hasIngredient
:hasIngredient rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Drink ;
               rdfs:range :Ingredient .


###  http://example.org/kr-group11/drinks#likesFlavour
:likesFlavour rdf:type owl:ObjectProperty ;
              rdfs:domain :Person ;
              rdfs:range :Flavour .


###  http://example.org/kr-group11/drinks#likesIngredient
:likesIngredient rdf:type owl:ObjectProperty ;
                 rdfs:domain :Person ;
                 rdfs:range :Ingredient .


#################################################################
#    Classes
#################################################################

###  http://example.org/kr-group11/drinks#AlcoholicDrink
:AlcoholicDrink rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Drink
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :hasIngredient ;
                                                             owl:someValuesFrom :AlcoholicIngredient
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Drink .


###  http://example.org/kr-group11/drinks#AlcoholicIngredient
:AlcoholicIngredient rdf:type owl:Class ;
                     rdfs:subClassOf :Ingredient ;
                     owl:disjointWith :NonAlcoholicIngredient .


###  http://example.org/kr-group11/drinks#AnimalProduct
:AnimalProduct rdf:type owl:Class ;
               rdfs:subClassOf :Ingredient ;
               owl:disjointWith :PlantBased .


###  http://example.org/kr-group11/drinks#Bitters
:Bitters rdf:type owl:Class ;
         rdfs:subClassOf :AlcoholicIngredient ,
                         :PlantBased .


###  http://example.org/kr-group11/drinks#CarbonatedMixer
:CarbonatedMixer rdf:type owl:Class ;
                 rdfs:subClassOf :NonAlcoholicIngredient ,
                                 :PlantBased .


###  http://example.org/kr-group11/drinks#Drink
:Drink rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :hasIngredient ;
                         owl:someValuesFrom :Ingredient
                       ] .


###  http://example.org/kr-group11/drinks#DrinkForMarco
:DrinkForMarco rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Drink
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :hasFlavour ;
                                                            owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty [ owl:inverseOf :hasFlavour
                                                                                                ] ;
                                                                                 owl:someValuesFrom [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty [ owl:inverseOf :likesIngredient
                                                                                                                     ] ;
                                                                                                      owl:hasValue :marco
                                                                                                    ]
                                                                               ]
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] .


###  http://example.org/kr-group11/drinks#DrinkForSara
:DrinkForSara rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Mocktail
                                                         :VeganDrink
                                                       ) ;
                                    rdf:type owl:Class
                                  ] .


###  http://example.org/kr-group11/drinks#Drinker
:Drinker rdf:type owl:Class ;
         rdfs:subClassOf :Person ;
         owl:disjointWith :NonDrinker .


###  http://example.org/kr-group11/drinks#Flavour
:Flavour rdf:type owl:Class .


###  http://example.org/kr-group11/drinks#FortifiedWine
:FortifiedWine rdf:type owl:Class ;
               rdfs:subClassOf :AlcoholicIngredient ,
                               :PlantBased .


###  http://example.org/kr-group11/drinks#Gin
:Gin rdf:type owl:Class ;
     rdfs:subClassOf :Spirit .


###  http://example.org/kr-group11/drinks#Herb
:Herb rdf:type owl:Class ;
      rdfs:subClassOf :NonAlcoholicIngredient ,
                      :PlantBased .


###  http://example.org/kr-group11/drinks#Ingredient
:Ingredient rdf:type owl:Class .


###  http://example.org/kr-group11/drinks#Juice
:Juice rdf:type owl:Class ;
       rdfs:subClassOf :NonAlcoholicIngredient ,
                       :PlantBased .


###  http://example.org/kr-group11/drinks#Liqueur
:Liqueur rdf:type owl:Class ;
         rdfs:subClassOf :AlcoholicIngredient .


###  http://example.org/kr-group11/drinks#Mocktail
:Mocktail rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :Drink
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :hasIngredient ;
                                                       owl:allValuesFrom :NonAlcoholicIngredient
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          rdfs:subClassOf :Drink .


###  http://example.org/kr-group11/drinks#NonAlcoholicIngredient
:NonAlcoholicIngredient rdf:type owl:Class ;
                        rdfs:subClassOf :Ingredient .


###  http://example.org/kr-group11/drinks#NonAlcoholicSpirit
:NonAlcoholicSpirit rdf:type owl:Class ;
                    rdfs:subClassOf :NonAlcoholicIngredient ,
                                    :PlantBased .


###  http://example.org/kr-group11/drinks#NonDrinker
:NonDrinker rdf:type owl:Class ;
            rdfs:subClassOf :Person .


###  http://example.org/kr-group11/drinks#NonVegan
:NonVegan rdf:type owl:Class ;
          rdfs:subClassOf :Person ;
          owl:disjointWith :Vegan .


###  http://example.org/kr-group11/drinks#Person
:Person rdf:type owl:Class .


###  http://example.org/kr-group11/drinks#PlantBased
:PlantBased rdf:type owl:Class ;
            rdfs:subClassOf :Ingredient .


###  http://example.org/kr-group11/drinks#Rum
:Rum rdf:type owl:Class ;
     rdfs:subClassOf :Spirit .


###  http://example.org/kr-group11/drinks#Spirit
:Spirit rdf:type owl:Class ;
        rdfs:subClassOf :AlcoholicIngredient ,
                        :PlantBased .


###  http://example.org/kr-group11/drinks#StrongDrink
:StrongDrink rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Drink
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :hasIngredient ;
                                                          owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                          owl:onClass :Spirit
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] .


###  http://example.org/kr-group11/drinks#Sweetener
:Sweetener rdf:type owl:Class ;
           rdfs:subClassOf :NonAlcoholicIngredient .


###  http://example.org/kr-group11/drinks#Tequila
:Tequila rdf:type owl:Class ;
         rdfs:subClassOf :Spirit .


###  http://example.org/kr-group11/drinks#Vegan
:Vegan rdf:type owl:Class ;
       rdfs:subClassOf :Person .


###  http://example.org/kr-group11/drinks#VeganDrink
:VeganDrink rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Drink
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasIngredient ;
                                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                                             owl:complementOf :AnimalProduct
                                                                           ]
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :Drink .


###  http://example.org/kr-group11/drinks#Vodka
:Vodka rdf:type owl:Class ;
       rdfs:subClassOf :Spirit .


###  http://example.org/kr-group11/drinks#Whiskey
:Whiskey rdf:type owl:Class ;
         rdfs:subClassOf :Spirit .


#################################################################
#    Individuals
#################################################################

###  http://example.org/kr-group11/drinks#angostura_bitters
:angostura_bitters rdf:type owl:NamedIndividual ,
                            :Bitters ;
                   :hasFlavour :bitter ,
                               :herbal .


###  http://example.org/kr-group11/drinks#baileys
:baileys rdf:type owl:NamedIndividual ,
                  [ owl:intersectionOf ( :AnimalProduct
                                         :Liqueur
                                       ) ;
                    rdf:type owl:Class
                  ] ;
         :hasFlavour :sweet .


###  http://example.org/kr-group11/drinks#baileys_coffee
:baileys_coffee rdf:type owl:NamedIndividual ,
                         :Drink ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasIngredient ;
                           owl:allValuesFrom [ rdf:type owl:Class ;
                                               owl:oneOf ( :baileys
                                                           :espresso
                                                         )
                                             ]
                         ] ;
                :hasIngredient :baileys ,
                               :espresso .


###  http://example.org/kr-group11/drinks#bees_knees
:bees_knees rdf:type owl:NamedIndividual ,
                     :Drink ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasIngredient ;
                       owl:allValuesFrom [ rdf:type owl:Class ;
                                           owl:oneOf ( :gin
                                                       :honey
                                                       :lemon_juice
                                                     )
                                         ]
                     ] ;
            :hasIngredient :gin ,
                           :honey ,
                           :lemon_juice .


###  http://example.org/kr-group11/drinks#bitter
:bitter rdf:type owl:NamedIndividual ,
                 :Flavour .


###  http://example.org/kr-group11/drinks#campari
:campari rdf:type owl:NamedIndividual ,
                  [ owl:intersectionOf ( :Liqueur
                                         :PlantBased
                                       ) ;
                    rdf:type owl:Class
                  ] ;
         :hasFlavour :bitter ,
                     :herbal .


###  http://example.org/kr-group11/drinks#citrus
:citrus rdf:type owl:NamedIndividual ,
                 :Flavour .


###  http://example.org/kr-group11/drinks#coffee_liqueur
:coffee_liqueur rdf:type owl:NamedIndividual ,
                         [ owl:intersectionOf ( :Liqueur
                                                :PlantBased
                                              ) ;
                           rdf:type owl:Class
                         ] ;
                :hasFlavour :bitter ,
                            :sweet .


###  http://example.org/kr-group11/drinks#cola
:cola rdf:type owl:NamedIndividual ,
               :CarbonatedMixer ;
      :hasFlavour :sweet .


###  http://example.org/kr-group11/drinks#cola_with_lime
:cola_with_lime rdf:type owl:NamedIndividual ,
                         :Drink ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasIngredient ;
                           owl:allValuesFrom [ rdf:type owl:Class ;
                                               owl:oneOf ( :cola
                                                           :lime_juice
                                                         )
                                             ]
                         ] ;
                :hasIngredient :cola ,
                               :lime_juice .


###  http://example.org/kr-group11/drinks#cosmopolitan
:cosmopolitan rdf:type owl:NamedIndividual ,
                       :Drink ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasIngredient ;
                         owl:allValuesFrom [ rdf:type owl:Class ;
                                             owl:oneOf ( :cranberry_juice
                                                         :lime_juice
                                                         :triple_sec
                                                         :vodka
                                                       )
                                           ]
                       ] ;
              :hasIngredient :cranberry_juice ,
                             :lime_juice ,
                             :triple_sec ,
                             :vodka .


###  http://example.org/kr-group11/drinks#cranberry_juice
:cranberry_juice rdf:type owl:NamedIndividual ,
                          :Juice ;
                 :hasFlavour :fruity ,
                             :sour .


###  http://example.org/kr-group11/drinks#cream
:cream rdf:type owl:NamedIndividual ,
                [ owl:intersectionOf ( :AnimalProduct
                                       :NonAlcoholicIngredient
                                     ) ;
                  rdf:type owl:Class
                ] .


###  http://example.org/kr-group11/drinks#cuba_libre
:cuba_libre rdf:type owl:NamedIndividual ,
                     :Drink ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasIngredient ;
                       owl:allValuesFrom [ rdf:type owl:Class ;
                                           owl:oneOf ( :cola
                                                       :lime_juice
                                                       :rum
                                                     )
                                         ]
                     ] ;
            :hasIngredient :cola ,
                           :lime_juice ,
                           :rum .


###  http://example.org/kr-group11/drinks#egg_white
:egg_white rdf:type owl:NamedIndividual ,
                    [ owl:intersectionOf ( :AnimalProduct
                                           :NonAlcoholicIngredient
                                         ) ;
                      rdf:type owl:Class
                    ] .


###  http://example.org/kr-group11/drinks#espresso
:espresso rdf:type owl:NamedIndividual ,
                   [ owl:intersectionOf ( :NonAlcoholicIngredient
                                          :PlantBased
                                        ) ;
                     rdf:type owl:Class
                   ] ;
          :hasFlavour :bitter .


###  http://example.org/kr-group11/drinks#espresso_martini
:espresso_martini rdf:type owl:NamedIndividual ,
                           :Drink ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasIngredient ;
                             owl:allValuesFrom [ rdf:type owl:Class ;
                                                 owl:oneOf ( :coffee_liqueur
                                                             :espresso
                                                             :sugar_syrup
                                                             :vodka
                                                           )
                                               ]
                           ] ;
                  :hasIngredient :coffee_liqueur ,
                                 :espresso ,
                                 :sugar_syrup ,
                                 :vodka .


###  http://example.org/kr-group11/drinks#eva
:eva rdf:type owl:NamedIndividual ,
              [ owl:intersectionOf ( :NonDrinker
                                     :NonVegan
                                   ) ;
                rdf:type owl:Class
              ] ;
     :dislikesFlavour :bitter ,
                      :sweet .


###  http://example.org/kr-group11/drinks#fruity
:fruity rdf:type owl:NamedIndividual ,
                 :Flavour .


###  http://example.org/kr-group11/drinks#gin
:gin rdf:type owl:NamedIndividual ,
              :Gin ;
     :hasFlavour :herbal .


###  http://example.org/kr-group11/drinks#gin_lemon
:gin_lemon rdf:type owl:NamedIndividual ,
                    :Drink ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasIngredient ;
                      owl:allValuesFrom [ rdf:type owl:Class ;
                                          owl:oneOf ( :gin
                                                      :lemon_soda
                                                    )
                                        ]
                    ] ;
           :hasIngredient :gin ,
                          :lemon_soda .


###  http://example.org/kr-group11/drinks#gin_tonic
:gin_tonic rdf:type owl:NamedIndividual ,
                    :Drink ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasIngredient ;
                      owl:allValuesFrom [ rdf:type owl:Class ;
                                          owl:oneOf ( :gin
                                                      :tonic_water
                                                    )
                                        ]
                    ] ;
           :hasIngredient :gin ,
                          :tonic_water .


###  http://example.org/kr-group11/drinks#ginger_ale
:ginger_ale rdf:type owl:NamedIndividual ,
                     :CarbonatedMixer ;
            :hasFlavour :sweet .


###  http://example.org/kr-group11/drinks#ginger_beer
:ginger_beer rdf:type owl:NamedIndividual ,
                      :CarbonatedMixer ;
             :hasFlavour :sweet .


###  http://example.org/kr-group11/drinks#glass_of_lemon_soda
:glass_of_lemon_soda rdf:type owl:NamedIndividual ,
                              :Drink ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasIngredient ;
                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                    owl:oneOf ( :lemon_soda
                                                              )
                                                  ]
                              ] ;
                     :hasIngredient :lemon_soda .


###  http://example.org/kr-group11/drinks#grapefruit_juice
:grapefruit_juice rdf:type owl:NamedIndividual ,
                           :Juice ;
                  :hasFlavour :bitter ,
                              :citrus ,
                              :sour .


###  http://example.org/kr-group11/drinks#grenadine
:grenadine rdf:type owl:NamedIndividual ,
                    [ owl:intersectionOf ( :PlantBased
                                           :Sweetener
                                         ) ;
                      rdf:type owl:Class
                    ] ;
           :hasFlavour :fruity ,
                       :sweet .


###  http://example.org/kr-group11/drinks#herbal
:herbal rdf:type owl:NamedIndividual ,
                 :Flavour .


###  http://example.org/kr-group11/drinks#honey
:honey rdf:type owl:NamedIndividual ,
                :AnimalProduct ,
                :Sweetener ,
                [ owl:intersectionOf ( :AnimalProduct
                                       :Sweetener
                                     ) ;
                  rdf:type owl:Class
                ] ;
       :hasFlavour :sweet .


###  http://example.org/kr-group11/drinks#honey_lemonade
:honey_lemonade rdf:type owl:NamedIndividual ,
                         :Drink ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasIngredient ;
                           owl:allValuesFrom [ rdf:type owl:Class ;
                                               owl:oneOf ( :honey
                                                           :lemon_juice
                                                           :soda_water
                                                         )
                                             ]
                         ] ;
                :hasIngredient :honey ,
                               :lemon_juice ,
                               :soda_water .


###  http://example.org/kr-group11/drinks#lemon_juice
:lemon_juice rdf:type owl:NamedIndividual ,
                      :Juice ;
             :hasFlavour :citrus ,
                         :sour .


###  http://example.org/kr-group11/drinks#lemon_lime_bitters
:lemon_lime_bitters rdf:type owl:NamedIndividual ,
                             :Drink ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :hasIngredient ;
                               owl:allValuesFrom [ rdf:type owl:Class ;
                                                   owl:oneOf ( :angostura_bitters
                                                               :lemon_soda
                                                               :lime_juice
                                                             )
                                                 ]
                             ] ;
                    :hasIngredient :angostura_bitters ,
                                   :lemon_soda ,
                                   :lime_juice .


###  http://example.org/kr-group11/drinks#lemon_soda
:lemon_soda rdf:type owl:NamedIndividual ,
                     :CarbonatedMixer ;
            :hasFlavour :citrus ,
                        :sweet .


###  http://example.org/kr-group11/drinks#lemonade
:lemonade rdf:type owl:NamedIndividual ,
                   :Drink ,
                   [ rdf:type owl:Restriction ;
                     owl:onProperty :hasIngredient ;
                     owl:allValuesFrom [ rdf:type owl:Class ;
                                         owl:oneOf ( :lemon_juice
                                                     :soda_water
                                                     :sugar_syrup
                                                   )
                                       ]
                   ] ;
          :hasIngredient :lemon_juice ,
                         :soda_water ,
                         :sugar_syrup .


###  http://example.org/kr-group11/drinks#lime_juice
:lime_juice rdf:type owl:NamedIndividual ,
                     :Juice ;
            :hasFlavour :citrus ,
                        :sour .


###  http://example.org/kr-group11/drinks#long_island_iced_tea
:long_island_iced_tea rdf:type owl:NamedIndividual ,
                               :Drink ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasIngredient ;
                                 owl:allValuesFrom [ rdf:type owl:Class ;
                                                     owl:oneOf ( :cola
                                                                 :gin
                                                                 :lemon_juice
                                                                 :rum
                                                                 :tequila
                                                                 :triple_sec
                                                                 :vodka
                                                               )
                                                   ]
                               ] ;
                      :hasIngredient :cola ,
                                     :gin ,
                                     :lemon_juice ,
                                     :rum ,
                                     :tequila ,
                                     :triple_sec ,
                                     :vodka .


###  http://example.org/kr-group11/drinks#luca
:luca rdf:type owl:NamedIndividual ,
               [ owl:intersectionOf ( :Drinker
                                      :Vegan
                                    ) ;
                 rdf:type owl:Class
               ] ;
      :likesIngredient :gin .


###  http://example.org/kr-group11/drinks#marco
:marco rdf:type owl:NamedIndividual ,
                [ owl:intersectionOf ( :Drinker
                                       :NonVegan
                                     ) ;
                  rdf:type owl:Class
                ] ;
       :likesIngredient :gin .


###  http://example.org/kr-group11/drinks#margarita
:margarita rdf:type owl:NamedIndividual ,
                    :Drink ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasIngredient ;
                      owl:allValuesFrom [ rdf:type owl:Class ;
                                          owl:oneOf ( :lime_juice
                                                      :tequila
                                                      :triple_sec
                                                    )
                                        ]
                    ] ;
           :hasIngredient :lime_juice ,
                          :tequila ,
                          :triple_sec .


###  http://example.org/kr-group11/drinks#mint
:mint rdf:type owl:NamedIndividual ,
               :Herb ;
      :hasFlavour :herbal .


###  http://example.org/kr-group11/drinks#mojito
:mojito rdf:type owl:NamedIndividual ,
                 :Drink ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :hasIngredient ;
                   owl:allValuesFrom [ rdf:type owl:Class ;
                                       owl:oneOf ( :lime_juice
                                                   :mint
                                                   :rum
                                                   :soda_water
                                                   :sugar_syrup
                                                 )
                                     ]
                 ] ;
        :hasIngredient :lime_juice ,
                       :mint ,
                       :rum ,
                       :soda_water ,
                       :sugar_syrup .


###  http://example.org/kr-group11/drinks#moscow_mule
:moscow_mule rdf:type owl:NamedIndividual ,
                      :Drink ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasIngredient ;
                        owl:allValuesFrom [ rdf:type owl:Class ;
                                            owl:oneOf ( :ginger_beer
                                                        :lime_juice
                                                        :vodka
                                                      )
                                          ]
                      ] ;
             :hasIngredient :ginger_beer ,
                            :lime_juice ,
                            :vodka .


###  http://example.org/kr-group11/drinks#na_gin_tonic
:na_gin_tonic rdf:type owl:NamedIndividual ,
                       :Drink ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasIngredient ;
                         owl:allValuesFrom [ rdf:type owl:Class ;
                                             owl:oneOf ( :non_alcoholic_gin
                                                         :tonic_water
                                                       )
                                           ]
                       ] ;
              :hasIngredient :non_alcoholic_gin ,
                             :tonic_water .


###  http://example.org/kr-group11/drinks#negroni
:negroni rdf:type owl:NamedIndividual ,
                  :Drink ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :hasIngredient ;
                    owl:allValuesFrom [ rdf:type owl:Class ;
                                        owl:oneOf ( :campari
                                                    :gin
                                                    :sweet_vermouth
                                                  )
                                      ]
                  ] ;
         :hasIngredient :campari ,
                        :gin ,
                        :sweet_vermouth .


