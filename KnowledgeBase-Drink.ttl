@prefix : <http://example.org/kr-group11/drinks#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/kr-group11/drinks#> .

<http://example.org/kr-group11/drinks> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/kr-group11/drinks#hasIngredient
:hasIngredient rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Drink ;
               rdfs:range :Ingredient .


#################################################################
#    Classes
#################################################################

###  http://example.org/kr-group11/drinks#AlcoholicDrink
:AlcoholicDrink rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Drink
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :hasIngredient ;
                                                             owl:someValuesFrom :AlcoholicIngredient
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :Drink .


###  http://example.org/kr-group11/drinks#AlcoholicIngredient
:AlcoholicIngredient rdf:type owl:Class ;
                     rdfs:subClassOf :Ingredient ;
                     owl:disjointWith :NonAlcoholicIngredient .


###  http://example.org/kr-group11/drinks#AnimalProduct
:AnimalProduct rdf:type owl:Class ;
               rdfs:subClassOf :Ingredient ;
               owl:disjointWith :PlantBased .


###  http://example.org/kr-group11/drinks#Bitters
:Bitters rdf:type owl:Class ;
         rdfs:subClassOf :AlcoholicIngredient ,
                         :PlantBased .


###  http://example.org/kr-group11/drinks#CarbonatedMixer
:CarbonatedMixer rdf:type owl:Class ;
                 rdfs:subClassOf :NonAlcoholicIngredient ,
                                 :PlantBased .


###  http://example.org/kr-group11/drinks#Drink
:Drink rdf:type owl:Class .


###  http://example.org/kr-group11/drinks#Drinker
:Drinker rdf:type owl:Class ;
         rdfs:subClassOf :Person ;
         owl:disjointWith :NonDrinker .


###  http://example.org/kr-group11/drinks#Flavour
:Flavour rdf:type owl:Class .


###  http://example.org/kr-group11/drinks#FortifiedWine
:FortifiedWine rdf:type owl:Class ;
               rdfs:subClassOf :AlcoholicIngredient ,
                               :PlantBased .


###  http://example.org/kr-group11/drinks#Gin
:Gin rdf:type owl:Class ;
     rdfs:subClassOf :Spirit .


###  http://example.org/kr-group11/drinks#Herb
:Herb rdf:type owl:Class ;
      rdfs:subClassOf :NonAlcoholicIngredient ,
                      :PlantBased .


###  http://example.org/kr-group11/drinks#Ingredient
:Ingredient rdf:type owl:Class .


###  http://example.org/kr-group11/drinks#Juice
:Juice rdf:type owl:Class ;
       rdfs:subClassOf :NonAlcoholicIngredient ,
                       :PlantBased .


###  http://example.org/kr-group11/drinks#Liqueur
:Liqueur rdf:type owl:Class ;
         rdfs:subClassOf :AlcoholicIngredient .


###  http://example.org/kr-group11/drinks#Mocktail
:Mocktail rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :Drink
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty :hasIngredient ;
                                                       owl:allValuesFrom :NonAlcoholicIngredient
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          rdfs:subClassOf :Drink .


###  http://example.org/kr-group11/drinks#NonAlcoholicIngredient
:NonAlcoholicIngredient rdf:type owl:Class ;
                        rdfs:subClassOf :Ingredient .


###  http://example.org/kr-group11/drinks#NonAlcoholicSpirit
:NonAlcoholicSpirit rdf:type owl:Class ;
                    rdfs:subClassOf :NonAlcoholicIngredient ,
                                    :PlantBased .


###  http://example.org/kr-group11/drinks#NonDrinker
:NonDrinker rdf:type owl:Class ;
            rdfs:subClassOf :Person .


###  http://example.org/kr-group11/drinks#NonVegan
:NonVegan rdf:type owl:Class ;
          rdfs:subClassOf :Person ;
          owl:disjointWith :Vegan .


###  http://example.org/kr-group11/drinks#Person
:Person rdf:type owl:Class .


###  http://example.org/kr-group11/drinks#PlantBased
:PlantBased rdf:type owl:Class ;
            rdfs:subClassOf :Ingredient .


###  http://example.org/kr-group11/drinks#Rum
:Rum rdf:type owl:Class ;
     rdfs:subClassOf :Spirit .


###  http://example.org/kr-group11/drinks#Spirit
:Spirit rdf:type owl:Class ;
        rdfs:subClassOf :AlcoholicIngredient ,
                        :PlantBased .


###  http://example.org/kr-group11/drinks#Sweetener
:Sweetener rdf:type owl:Class ;
           rdfs:subClassOf :NonAlcoholicIngredient .


###  http://example.org/kr-group11/drinks#Tequila
:Tequila rdf:type owl:Class ;
         rdfs:subClassOf :Spirit .


###  http://example.org/kr-group11/drinks#Vegan
:Vegan rdf:type owl:Class ;
       rdfs:subClassOf :Person .


###  http://example.org/kr-group11/drinks#VeganDrink
:VeganDrink rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Drink
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasIngredient ;
                                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                                             owl:complementOf :AnimalProduct
                                                                           ]
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :Drink .


###  http://example.org/kr-group11/drinks#Vodka
:Vodka rdf:type owl:Class ;
       rdfs:subClassOf :Spirit .


###  http://example.org/kr-group11/drinks#Whiskey
:Whiskey rdf:type owl:Class ;
         rdfs:subClassOf :Spirit .


#################################################################
#    Individuals
#################################################################

###  http://example.org/kr-group11/drinks#baileys
:baileys rdf:type owl:NamedIndividual ,
                  [ owl:intersectionOf ( :AnimalProduct
                                         :Liqueur
                                       ) ;
                    rdf:type owl:Class
                  ] .


###  http://example.org/kr-group11/drinks#bees_knees
:bees_knees rdf:type owl:NamedIndividual ,
                     :Drink ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :hasIngredient ;
                       owl:allValuesFrom [ rdf:type owl:Class ;
                                           owl:oneOf ( :gin
                                                       :honey
                                                       :lemon_juice
                                                     )
                                         ]
                     ] ;
            :hasIngredient :gin ,
                           :honey ,
                           :lemon_juice .


###  http://example.org/kr-group11/drinks#egg_white
:egg_white rdf:type owl:NamedIndividual ,
                    [ owl:intersectionOf ( :AnimalProduct
                                           :NonAlcoholicIngredient
                                         ) ;
                      rdf:type owl:Class
                    ] .


###  http://example.org/kr-group11/drinks#gin
:gin rdf:type owl:NamedIndividual ,
              :Gin .


###  http://example.org/kr-group11/drinks#gin_lemon
:gin_lemon rdf:type owl:NamedIndividual ,
                    :Drink ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasIngredient ;
                      owl:allValuesFrom [ rdf:type owl:Class ;
                                          owl:oneOf ( :gin
                                                      :lemon_soda
                                                    )
                                        ]
                    ] ;
           :hasIngredient :gin ,
                          :lemon_soda .


###  http://example.org/kr-group11/drinks#gin_tonic
:gin_tonic rdf:type owl:NamedIndividual ,
                    :Drink ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasIngredient ;
                      owl:allValuesFrom [ rdf:type owl:Class ;
                                          owl:oneOf ( :gin
                                                      :tonic_water
                                                    )
                                        ]
                    ] ;
           :hasIngredient :gin ,
                          :tonic_water .


###  http://example.org/kr-group11/drinks#glass_of_lemon_soda
:glass_of_lemon_soda rdf:type owl:NamedIndividual ,
                              :Drink ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasIngredient ;
                                owl:allValuesFrom [ rdf:type owl:Class ;
                                                    owl:oneOf ( :lemon_soda
                                                              )
                                                  ]
                              ] ;
                     :hasIngredient :lemon_soda .


###  http://example.org/kr-group11/drinks#honey
:honey rdf:type owl:NamedIndividual ,
                :AnimalProduct ,
                :Sweetener .


###  http://example.org/kr-group11/drinks#lemon_juice
:lemon_juice rdf:type owl:NamedIndividual ,
                      :Juice .


###  http://example.org/kr-group11/drinks#lemon_soda
:lemon_soda rdf:type owl:NamedIndividual ,
                     :CarbonatedMixer .


###  http://example.org/kr-group11/drinks#sugar_syrup
:sugar_syrup rdf:type owl:NamedIndividual ,
                      [ owl:intersectionOf ( :PlantBased
                                             :Sweetener
                                           ) ;
                        rdf:type owl:Class
                      ] .


###  http://example.org/kr-group11/drinks#tonic_water
:tonic_water rdf:type owl:NamedIndividual ,
                      :CarbonatedMixer .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Bitters
                :FortifiedWine
                :Liqueur
                :Spirit
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :CarbonatedMixer
                :Herb
                :Juice
                :NonAlcoholicSpirit
                :Sweetener
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Drink
                :Flavour
                :Ingredient
                :Person
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Gin
                :Rum
                :Tequila
                :Vodka
                :Whiskey
              )
] .


